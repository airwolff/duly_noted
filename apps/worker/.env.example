SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ASR_VENDOR_API_KEY=
ASR_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional locally (a residential IP needs no proxy); required in production —
# YouTube 429s + bot-checks yt-dlp from datacenter ranges. See ADR 0019.
# Must pin ONE exit IP for the whole run: YouTube binds each media URL to the
# requesting IP, so a rotating gateway 403s at download time even though
# metadata extraction succeeds. ProxyWing does this with username suffixes —
# http://<user>-country-us-session-<id>:<pass>@quality.proxywing.com:8888
# Both suffixes are required; see apps/worker/src/pipeline/extract.ts.
YT_DLP_PROXY_URL=
